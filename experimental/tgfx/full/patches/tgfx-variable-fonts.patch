+static bool SetVariations(FT_Face face, const std::vector<FontVariation>& requested,
+                          std::vector<FontVariation>* applied) {
+  if (!FT_HAS_MULTIPLE_MASTERS(face) || !FT_IS_SFNT(face)) {
+    return requested.empty();
+  }
+  FT_MM_Var* axes = nullptr;
+  if (FT_Get_MM_Var(face, &axes) != FT_Err_Ok || axes == nullptr) {
+    return false;
+  }
+  auto releaseAxes = [](FT_MM_Var* value) { FT_Done_MM_Var(FTLibrary::Get(), value); };
+  std::unique_ptr<FT_MM_Var, decltype(releaseAxes)> axesOwner(axes, releaseAxes);
+  std::vector<FT_Fixed> values(axes->num_axis);
+  // Preserve a named TTC instance as well as every unrequested axis.
+  if (FT_Get_Var_Design_Coordinates(face, axes->num_axis, values.data()) != FT_Err_Ok) {
+    return false;
+  }
+  for (const auto& coordinate : requested) {
+    if (!std::isfinite(coordinate.value)) {
+      return false;
+    }
+    FT_UInt index = 0;
+    for (; index < axes->num_axis; ++index) {
+      if (axes->axis[index].tag == coordinate.axis) {
+        break;
+      }
+    }
+    if (index == axes->num_axis) {
+      return false;
+    }
+    auto value = std::clamp(static_cast<double>(coordinate.value) * 65536.0,
+                            static_cast<double>(axes->axis[index].minimum),
+                            static_cast<double>(axes->axis[index].maximum));
+    values[index] = static_cast<FT_Fixed>(std::round(value));
+  }
+  if (!requested.empty() &&
+      FT_Set_Var_Design_Coordinates(face, axes->num_axis, values.data()) != FT_Err_Ok) {
+    return false;
+  }
+  // Read back the actual instance rather than echoing an unclamped request.
+  if (FT_Get_Var_Design_Coordinates(face, axes->num_axis, values.data()) != FT_Err_Ok) {
+    return false;
+  }
+  applied->reserve(axes->num_axis);
+  for (FT_UInt i = 0; i < axes->num_axis; ++i) {
+    applied->push_back({static_cast<FontTableTag>(axes->axis[i].tag),
+                        static_cast<float>(values[i] / 65536.0)});
+  }
+  return true;
+}
