# Runtime wire format only. The Swift Valdi compiler source and targets are removed.
load("@protobuf_cpp//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@protobuf_cpp//bazel:proto_library.bzl", "proto_library")

proto_library(
    name = "valdi_proto",
    srcs = ["valdi.proto"],
    import_prefix = "valdi",
    strip_import_prefix = "",
)

cc_proto_library(
    name = "valdi_proto_cc",
    visibility = ["//visibility:public"],
    deps = [":valdi_proto"],
)
