+std::shared_ptr<Image> RenderContext::captureDestination(const Rect& bounds) {
+  RenderErrorScope errorScope(getContext(), renderErrorState());
+  auto drawingManager = getContext()->drawingManager();
+  auto source = renderTarget;
+  if (surface) {
+    source = surface->resolveCopySource(drawingManager);
+    if (!source) {
+      return nullptr;
+    }
+    surface->closeDrawingForCopy(drawingManager, source);
+  } else {
+    flush();
+  }
+  if (bounds.isEmpty() || !source->bounds().contains(bounds)) {
+    return nullptr;
+  }
+  // Independent, exact-sized copy: never snapshot the whole target or create
+  // a subset view retaining a target-sized COW image.
+  auto copy = getContext()->proxyProvider()->createTextureProxy(
+      {}, static_cast<int>(bounds.width()), static_cast<int>(bounds.height()),
+      source->format(), false, source->origin(), BackingFit::Exact);
+  if (!copy) {
+    return nullptr;
+  }
+  auto sourceBounds = source->getOriginTransform().mapRect(bounds);
+  drawingManager->addRenderTargetCopyTask(source, copy, static_cast<int>(sourceBounds.left),
+                                         static_cast<int>(sourceBounds.top));
+  if (surface) {
+    surface->collectFrameUsage(drawingManager, source);
+  }
+  return TextureImage::Wrap(std::move(copy), _colorSpace);
+}
