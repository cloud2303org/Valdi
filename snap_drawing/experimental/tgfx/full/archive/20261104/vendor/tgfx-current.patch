+std::shared_ptr<Typeface> FTTypeface::makeWithVariations(
+    const std::vector<FontVariation>& coordinates) const {
+  if (coordinates.empty()) {
+    return weakThis.lock();
+  }
+  auto merged = variationCoordinates;
+  for (const auto& coordinate : coordinates) {
+    if (!std::isfinite(coordinate.value)) return nullptr;
+    auto found = std::find_if(merged.begin(), merged.end(), [&](const FontVariation& previous) {
+      return previous.axis == coordinate.axis;
+    });
+    if (found == merged.end()) {
+      merged.push_back(coordinate);
+    } else {
+      found->value = coordinate.value;
+    }
+  }
+  // A new face, uniqueID, and scaler/bounds caches keep existing fonts immutable.
+  return Make(data, merged);
+}
