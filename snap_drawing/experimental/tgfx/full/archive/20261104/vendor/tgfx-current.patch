+  if (FT_Get_MM_Var(face, &axes) != FT_Err_Ok || axes == nullptr) {
+    return false;
+  }
+  auto releaseAxes = [](FT_MM_Var* value) { FT_Done_MM_Var(FTLibrary::Get(), value); };
