+  if (!requested.empty() &&
+      FT_Set_Var_Design_Coordinates(face, axes->num_axis, values.data()) != FT_Err_Ok) {
+    return false;
+  }
+  // Read back the actual instance rather than echoing an unclamped request.
+  if (FT_Get_Var_Design_Coordinates(face, axes->num_axis, values.data()) != FT_Err_Ok) {
