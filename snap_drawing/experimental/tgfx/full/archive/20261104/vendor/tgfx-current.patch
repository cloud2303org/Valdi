+bool DrawContext::saveBehind(const Rect& subset, const Matrix& matrix, const ClipStack& clip) {
+  if (!matrix.isFinite() || !std::isfinite(subset.left) || !std::isfinite(subset.top) ||
+      !std::isfinite(subset.right) || !std::isfinite(subset.bottom)) {
+    behindStack.push({});
+    markRenderFailure();
+    return false;
+  }
+  auto bounds = matrix.mapRect(subset);
+  bounds.roundOut();
+  auto targetBounds = deviceBounds();
+  if (bounds.isEmpty() || clip.state() == ClipState::Empty ||
+      (!targetBounds.isEmpty() && !bounds.intersect(targetBounds)) ||
+      (clip.state() != ClipState::WideOpen && !bounds.intersect(clip.bounds()))) {
+    // Empty saves are successful, allocation-free, and still balanced.
+    behindStack.push({});
+    return true;
+  }
+  bounds.roundOut();
+  if (!targetBounds.isEmpty() && !bounds.intersect(targetBounds)) {
+    behindStack.push({});
+    return true;
+  }
+  auto savedClip = clip;
+  savedClip.clipRect(bounds, Matrix::I(), false);
+  auto image = captureDestination(bounds);
+  behindStack.push({image, savedClip, {bounds.left, bounds.top}});
+  if (!image) {
+    markRenderFailure();
+    LOGE("saveBehind could not capture its GPU destination");
+    return false;
+  }
+  Brush clear = {};
+  clear.blendMode = BlendMode::Clear;
+  drawRect(bounds, Matrix::I(), savedClip, clear, nullptr);
+  return true;
+}
+
+void DrawContext::restoreBehind() {
+  if (behindStack.empty()) {
+    markRenderFailure();
+    LOGE("restoreBehind without matching saveBehind");
+    return;
+  }
+  auto saved = std::move(behindStack.top());
+  behindStack.pop();
+  if (saved.image) {
+    Brush behind = {};
+    behind.blendMode = BlendMode::DstOver;
+    drawImage(std::move(saved.image), SamplingOptions(FilterMode::Nearest, MipmapMode::None),
+              Matrix::MakeTrans(saved.origin.x, saved.origin.y), saved.clip, behind);
+  }
+}
