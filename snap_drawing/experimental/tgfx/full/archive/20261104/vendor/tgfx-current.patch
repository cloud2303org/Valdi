diff --git a/src/core/RenderErrorState.h b/src/core/RenderErrorState.h
new file mode 100644
index 0000000..acde5e0
--- /dev/null
+++ b/src/core/RenderErrorState.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include <atomic>
+#include <memory>
+#include <utility>
+#include "tgfx/gpu/Context.h"
+
+namespace tgfx {
+
+// Status belongs to the rendering destination, including work it requests from
+// offscreen children. Pictures never retain it. Atomic storage preserves status
+// across serialized Device unlock/lock transfers to another thread.
+class RenderErrorState {
+ public:
+  bool hasError() const { return failed.load(std::memory_order_relaxed); }
+  void markFailure() { failed.store(true, std::memory_order_relaxed); }
+
+ private:
+  std::atomic<bool> failed{false};
+};
+
+// Explicit dynamic ancestry on the locked GPU Context, never on thread-local
+// storage. Each compositor installs its OWN state, including when another
+// destination closes its pending work. Nested offscreen rendering shares only
+// the state explicitly passed by the operation requesting it.
+class RenderErrorScope {
+ public:
+  RenderErrorScope(Context* context, std::shared_ptr<RenderErrorState> state)
+      : context(context), previous(std::move(context->activeRenderErrorState)) {
+    context->activeRenderErrorState = std::move(state);
+  }
+  ~RenderErrorScope() { context->activeRenderErrorState = std::move(previous); }
+  RenderErrorScope(const RenderErrorScope&) = delete;
+  RenderErrorScope& operator=(const RenderErrorScope&) = delete;
+
+  static std::shared_ptr<RenderErrorState> Current(Context* context) {
+    return context->activeRenderErrorState;
+  }
+  static void MarkFailure(Context* context) {
+    if (auto state = Current(context)) {
+      state->markFailure();
+    }
+  }
+
+ private:
+  Context* context;
+  std::shared_ptr<RenderErrorState> previous;
+};
+}  // namespace tgfx
