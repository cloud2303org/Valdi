+void RenderContext::drawDeferredLayer(std::shared_ptr<Picture> picture,
+                                      std::shared_ptr<ImageFilter> filter, const Matrix& matrix,
+                                      const ClipStack& clip, const Brush& brush) {
+  // Device effects must see the complete final transform. PictureImage's scalar
+  // drawScale would rasterize at (maxScale,maxScale), then compress an axis during
+  // composition, changing device-space blur/outset semantics.
+  auto neededBounds = getClipBounds(clip);
+  if (neededBounds.isEmpty()) {
+    return;
+  }
+  Matrix inverse;
+  if (!matrix.isFinite() || !matrix.invert(&inverse)) {
+    return;
+  }
+  if (filter) {
+    // Preserve filter input outside the destination clip that can contribute to
+    // visible output. The outer filter still operates in its original local space.
+    neededBounds = matrix.mapRect(filter->filterBounds(inverse.mapRect(neededBounds),
+                                                        MapDirection::Reverse));
+  }
+  ClipStack measureClip;
+  measureClip.clipRect(neededBounds, Matrix::I(), false);
+  MeasureContext measure;
+  picture->playback(&measure, matrix, measureClip); // Never invokes deferred callbacks.
+  auto bounds = picture->hasUnboundedFill() ? neededBounds : measure.getBounds();
+  if (!bounds.intersect(neededBounds)) {
+    return;
+  }
+  bounds.roundOut();
+  const auto width = FloatSaturateToInt(bounds.width());
+  const auto height = FloatSaturateToInt(bounds.height());
+  auto target = RenderTargetProxy::Make(getContext(), width, height, false, 1, false,
+                                         ImageOrigin::TopLeft, BackingFit::Exact);
+  if (target == nullptr) {
+    markRenderFailure();
+    return;
+  }
+  auto replayMatrix = matrix;
+  replayMatrix.postTranslate(-bounds.left, -bounds.top);
+  RenderContext child(target, renderFlags, true, nullptr, colorSpace(), renderErrorState());
+  picture->playback(&child, replayMatrix, ClipStack());
+  child.flush();
+  if (child.hasError()) {
+    markRenderFailure();
+    return;
+  }
+  auto image = TextureImage::Wrap(target->asTextureProxy(), colorSpace());
+  if (image == nullptr) {
+    markRenderFailure();
+    return;
+  }
+  if (filter) {
+    // Bake the device-effect result first, then map that texture back to local
+    // coordinates for the ordinary layer-filter pipeline. Subsequent scalar
+    // sampling can resample pixels but cannot re-execute a deferred device effect
+    // under a different transform. Group brush/opacity is applied only at the end.
+    PictureRecorder recorder;
+    auto canvas = recorder.beginRecording();
+    canvas->concat(inverse);
+    canvas->drawImage(std::move(image), bounds.left, bounds.top);
+    auto flattened = recorder.finishRecordingAsPicture();
+    if (flattened == nullptr) {
+      markRenderFailure();
+      return;
+    }
+    drawLayer(std::move(flattened), std::move(filter), matrix, clip, brush);
+    return;
+  }
+  drawImage(std::move(image), {}, Matrix::MakeTrans(bounds.left, bounds.top), clip,
+            brush.makeWithMatrix(replayMatrix));
+}
