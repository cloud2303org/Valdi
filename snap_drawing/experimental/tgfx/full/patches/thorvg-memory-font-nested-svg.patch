-    return retrieve(_findFromCache(filename));
+bool LoaderMgr::unregisterFont(const char* identifier, bool memory)
+{
+    if (!identifier) return false;
+    Loader* removed = nullptr;
+    bool dispose = false;
+    {
+        ScopedLock lock(_key);
+        INLIST_FOREACH(_activeLoaders, loader) {
+            if (!loader->cached || loader->type != FileType::Sfnt) continue;
+            const char* key = memory ? static_cast<FontLoader*>(loader)->name : loader->hashpath;
+            if (memory && loader->hashpath) continue;
+            if (!key || strcmp(key, identifier)) continue;
+            _activeLoaders.remove(loader);
+            loader->cached = false;
+            // Drop the registry's reference, without acquiring a lookup ref.
+            // Live Text paints retain the detached loader until their release.
+            dispose = loader->close();
+            removed = loader;
+            break;
+        }
+    }
+    if (dispose) delete removed;
+    return removed != nullptr;
 }
 
