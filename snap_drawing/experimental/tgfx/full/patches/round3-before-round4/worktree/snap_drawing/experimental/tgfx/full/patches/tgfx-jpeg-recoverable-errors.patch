 #ifdef TGFX_USE_JPEG_ENCODE
+// libjpeg's stock jpeg_mem_dest publishes its grown buffer only at finish.
+// A fatal error after a grow can therefore leave the caller with a stale
+// pointer. Keep the current allocation in caller-owned state on every grow.
+struct JpegOutput {
+  jpeg_destination_mgr pub;
+  unsigned char* bytes = nullptr;
+  size_t capacity = 0;
+  size_t length = 0;
+};
+
+extern "C" {
+static void InitJpegOutput(j_compress_ptr cinfo) {
+  auto* output = reinterpret_cast<JpegOutput*>(cinfo->dest);
+  if (output->bytes == nullptr) {
+    output->capacity = 4096;
+    output->bytes = static_cast<unsigned char*>(std::malloc(output->capacity));
+    if (output->bytes == nullptr) ERREXIT1(cinfo, JERR_OUT_OF_MEMORY, 10);
+  }
+  output->length = 0;
+  output->pub.next_output_byte = output->bytes;
+  output->pub.free_in_buffer = output->capacity;
+}
+
+static boolean GrowJpegOutput(j_compress_ptr cinfo) {
+  auto* output = reinterpret_cast<JpegOutput*>(cinfo->dest);
+  if (output->capacity > std::numeric_limits<size_t>::max() / 2) {
+    ERREXIT1(cinfo, JERR_OUT_OF_MEMORY, 10);
+  }
+  const auto nextCapacity = output->capacity * 2;
+  auto* bytes = static_cast<unsigned char*>(std::realloc(output->bytes, nextCapacity));
+  if (bytes == nullptr) ERREXIT1(cinfo, JERR_OUT_OF_MEMORY, 10);
+  output->bytes = bytes;
+  output->pub.next_output_byte = bytes + output->capacity;
+  output->pub.free_in_buffer = nextCapacity - output->capacity;
+  output->capacity = nextCapacity;
+  return TRUE;
+}
+
+static void FinishJpegOutput(j_compress_ptr cinfo) {
+  auto* output = reinterpret_cast<JpegOutput*>(cinfo->dest);
+  output->length = output->capacity - output->pub.free_in_buffer;
+}
+}
