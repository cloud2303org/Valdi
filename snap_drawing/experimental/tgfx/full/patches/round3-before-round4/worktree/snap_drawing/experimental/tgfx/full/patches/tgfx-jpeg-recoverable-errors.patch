-struct my_error_mgr {
-  struct jpeg_error_mgr pub;
-  jmp_buf setjmp_buffer;
+struct JpegCallError {
+  jpeg_error_mgr pub;
+  std::jmp_buf jump;
+  jpeg_error_mgr* previous;
 };
 
+extern "C" {
+static void RecoverJpegError(j_common_ptr cinfo) {
+  auto* error = reinterpret_cast<JpegCallError*>(cinfo->err);
+  // Retain the normal diagnostic; replace only the process-exiting control flow.
+  (*cinfo->err->output_message)(cinfo);
+  std::longjmp(error->jump, 1);
+}
+
+static void RecoverJpegWarning(j_common_ptr cinfo, int level) {
+  auto* error = reinterpret_cast<JpegCallError*>(cinfo->err);
+  (*error->previous->emit_message)(cinfo, level);
+  // libjpeg otherwise inserts a fabricated EOI and can return successful
+  // partial pixels for an incomplete header/entropy stream. Keep warnings
+  // visible, but report these specific incomplete-input conditions as failure.
+  if (level < 0 &&
+      (cinfo->err->msg_code == JWRN_JPEG_EOF || cinfo->err->msg_code == JWRN_HIT_MARKER)) {
+    std::longjmp(error->jump, 1);
+  }
+}
+}
+
+// The jump target covers ONE C-only operation, never an enclosing decode or
+// encode function. Bitmap/Pixmap/vector/shared_ptr lifetimes remain in the
+// caller frame, which is not unwound by a libjpeg error. The operation must
+// capture only trivial state and must not create C++ objects or call C++ code.
+template <typename CInfo, typename Operation>
+static bool JpegCall(CInfo* cinfo, Operation operation) {
+  static_assert(std::is_trivially_copyable<Operation>::value,
+                "JPEG operations may capture only trivial state");
+  static_assert(std::is_trivially_destructible<Operation>::value,
+                "JPEG operations must not require unwinding");
+  auto* previous = cinfo->err;
+  JpegCallError error = {};
+  error.pub = *previous;
+  error.previous = previous;
+  error.pub.error_exit = RecoverJpegError;
+  error.pub.emit_message = RecoverJpegWarning;
+  cinfo->err = &error.pub;
+  if (setjmp(error.jump) != 0) {
+    // Do not inspect error.pub after longjmp: libjpeg modified this automatic
+    // object after setjmp, so its value is indeterminate on this branch.
+    cinfo->err = previous;
+    return false;
+  }
+  operation();
+  // Preserve ordinary warning counts/messages without retaining stack-local
+  // callbacks or a jump buffer after this guarded call returns.
+  const auto errorExit = previous->error_exit;
+  const auto emitMessage = previous->emit_message;
+  *previous = error.pub;
+  previous->error_exit = errorExit;
+  previous->emit_message = emitMessage;
+  cinfo->err = previous;
+  return true;
+}
